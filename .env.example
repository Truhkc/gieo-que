# 复制为 .env.local 后填入实际值

# ─── AI 推理 ───────────────────────────────────────────────
# /api/interpret（单盘解读）与 /api/heming（合盘分析）用这组配置。
# 只想排盘、看命盘、读古籍的话整段都不用填 —— 排盘在浏览器里完成，不需要任何 Key。
#
# AI_PROVIDER 选一档，然后只填那一档对应的变量：
#   deepseek  | anthropic | openai | mimo | custom
#
# 各档的默认值（base_url / model 可以用对应变量覆盖）：
#   deepseek   DEEPSEEK_API_KEY   base=https://api.deepseek.com/v1   model=deepseek-chat
#   anthropic  ANTHROPIC_API_KEY  base=https://api.anthropic.com     model=claude-sonnet-5-5
#   openai     OPENAI_API_KEY     base=https://api.openai.com/v1     model=gpt-4o
#   mimo       MIMO_API_KEY       base/model 必填
#   custom     AI_API_KEY         base/model 必填

AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ─── 或用 Anthropic ───
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-api-key
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ─── 或用 OpenAI ───
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-api-key
# OPENAI_MODEL=gpt-4o

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 或任意 OpenAI 兼容端点 ───
# AI_PROVIDER=custom
# AI_API_KEY=your-api-key
# AI_BASE_URL=https://your-provider/v1
# AI_MODEL=model-name

# ─── Nhiều nhà cung cấp, tự chuyển khi lỗi / 多家模型自动切换 ───
# Khai AI_PROVIDERS thì bỏ qua AI_PROVIDER ở trên. Thử lần lượt từ trái sang phải;
# cái trước lỗi (sai key, hết credit, 5xx) trước khi trả chữ đầu tiên thì chuyển cái sau.
# Tên có sẵn (deepseek / anthropic / openai / mimo / custom) dùng đúng biến của nó;
# tên tự đặt thì khai nhóm AI_<TÊN>_* (gạch nối thành gạch dưới, viết hoa).
# AI_PROVIDERS=anthropic,gemini,deepseek
# AI_GEMINI_KIND=openai                 # openai | anthropic, mặc định openai
# AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_GEMINI_API_KEY=your-api-key
# AI_GEMINI_MODEL=gemini-2.5-flash
#
# Người xem còn có thể tự nhập API key của họ ở nút «Cài đặt API» trên trang;
# key đó chỉ lưu trong trình duyệt của họ, không cần khai gì ở đây.

# ─── 限流（进程内计数）───────────────────────────────────────
# 每个 IP 在 AI_RATE_WINDOW_SEC 秒内最多调用 AI_RATE_LIMIT 次。
# 注意：计数存在单个 Node 进程的内存里 —— serverless 多实例下每个实例一份，
# 只能挡连点，挡不住有心刷量。要真防刷请改成 Redis 实现或上游 WAF。
# AI_RATE_LIMIT=20
# AI_RATE_WINDOW_SEC=300

# ─── 站点 ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── 搜索引擎站点验证（可选）─────────────────────────────────
# NEXT_PUBLIC_GOOGLE_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION=
# NEXT_PUBLIC_BAIDU_VERIFICATION=
# NEXT_PUBLIC_360_VERIFICATION=

# ─── 13 维解读数据集 v4.0 ─────────────────────────────────────
# 上游 Renhuai123/ziwei-doushu release v4.0-13d，CC BY 4.0。
# 什么都不配：服务端直接从 GitHub release 流式读（需要 Node ≥ 22.15，见 docs/INTERP-DATASET.md）。
# 关掉这一档、只用 AI：
# ZIWEI_INTERP_SOURCE=off
#
# 更快的两种（先用 scripts/dataset/pack-interp-v4.ts 打包成每天一个 brotli 对象，共约 3.9 GiB）：
#
# 本地目录（开发用）：pack 脚本的 --out
# ZIWEI_INTERP_DIR=D:/ziwei-interp
#
# Cloudflare R2 私有桶：线上用「只读」令牌（Object Read only，只授权这个桶）。
# 上传用 scripts/dataset/upload-r2.ts，那一步另用可写令牌，不要放进 Vercel。
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
